# macOS host debris — add this line to every .gitignore in every repository
# (some humans will be using a Mac).
.DS_Store

# Nested clones in the harness layout
/sprout/

# Secrets never belong here; .env lives at the root but is never committed
.env

# Python build artifacts
__pycache__/
*.pyc

# Listener logs persist here on the host (issue #17) — evidence, not code
/listener-logs/
